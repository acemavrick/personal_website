---
// Hero component - uses sitewide config
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import { site } from '../config';

const { name, pfp, taglines, links } = site;

// new tab for everything but mail, résumé PDF included
const opensNewTab = (href: string) => !href.startsWith('mailto');
---

<section class="flex justify-center pt-16 pb-20">
	<div class="flex flex-col items-center gap-4">
		<!-- avatar with glow ring -->
		<div class="fade-up avatar-wrapper mb-1">
			<div class="avatar-glow"></div>
			<Image
				src={pfp}
				alt={name}
				width={120}
				height={120}
				class="avatar relative rounded-full border-2 border-white/20 transition-all duration-500"
			/>
		</div>

		<!-- name with gradient -->
		<h1 class="fade-up delay-1 text-4xl md:text-5xl font-semibold tracking-tight">
			<span class="bg-linear-to-br from-white via-neutral-200 to-neutral-400 bg-clip-text text-transparent">{name}</span>
		</h1>

		<!-- canonical one is server-rendered for no-JS and crawlers; the inline
		     script swaps in a random variant before paint -->
		<p id="tagline" class="fade-up delay-2 text-lg text-neutral-300 tracking-wide max-w-xl text-center leading-relaxed">{taglines[0]}</p>
		<script is:inline define:vars={{ taglines }}>
			(function () {
				// for a daily variant instead:
				// var i = Math.floor(Date.now() / 86400000) % taglines.length;
				var i = Math.floor(Math.random() * taglines.length);
				if (i > 0) document.getElementById('tagline').textContent = taglines[i];
				// record which one was shown
				window.dataLayer = window.dataLayer || [];
				window.dataLayer.push({ event: 'tagline_variant', tagline_variant: i });
			})();
		</script>

		<!-- quick links: accented professional row, bare personal row -->
		<nav class="fade-up delay-3 flex flex-col items-center gap-3 mt-5" aria-label="Quick links">
			<ul class="flex flex-wrap justify-center gap-3">
				{links.primary.map(({ href, handle, icon }) => (
					<li>
						<a
							href={href}
							target={opensNewTab(href) ? '_blank' : undefined}
							rel={opensNewTab(href) ? 'noopener noreferrer' : undefined}
							class="quick-link flex items-center gap-2 rounded-xl border border-white/15 bg-white/8 px-4 py-2.5 backdrop-blur-sm transition-all duration-300"
						>
							<Icon name={icon} class="size-4 text-neutral-200" />
							<span class="text-sm font-medium text-neutral-100">{handle}</span>
						</a>
					</li>
				))}
			</ul>

			<ul class="flex flex-wrap justify-center gap-3">
				{links.secondary.map(({ href, handle, icon }) => (
					<li>
						<a
							href={href}
							target={opensNewTab(href) ? '_blank' : undefined}
							rel={opensNewTab(href) ? 'noopener noreferrer' : undefined}
							class:list={[
								"bare-link flex items-center gap-1.5 rounded-lg px-2 py-1 transition-all duration-300",
								`brand-${icon.split(':')[1]}`
							]}
						>
							<Icon name={icon} class="size-3.5" />
							<span class="text-xs text-neutral-400">{handle}</span>
						</a>
					</li>
				))}
			</ul>
		</nav>
	</div>
</section>

<style>
	/* avatar with animated glow */
	.avatar-wrapper {
		position: relative;
	}

	.avatar-glow {
		position: absolute;
		inset: -8px;
		border-radius: 50%;
		background: conic-gradient(from 0deg, rgba(16, 185, 129, 0.4), rgba(59, 130, 246, 0.3), rgba(168, 85, 247, 0.3), rgba(16, 185, 129, 0.4));
		filter: blur(20px);
		opacity: 0.6;
		animation: glow-rotate 8s linear infinite;
	}

	@keyframes glow-rotate {
		from { transform: rotate(0deg); }
		to { transform: rotate(360deg); }
	}

	.avatar-wrapper:hover .avatar-glow {
		opacity: 0.9;
		filter: blur(25px);
	}

	.avatar-wrapper:hover .avatar {
		border-color: rgba(255, 255, 255, 0.4);
		transform: scale(1.02);
	}

	/* top row: filled, bordered, lifts on hover */
	.quick-link {
		box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
	}

	.quick-link:hover {
		transform: translateY(-3px);
		background: rgba(255, 255, 255, 0.12);
		border-color: rgba(16, 185, 129, 0.35);
		box-shadow: 0 8px 20px rgba(0, 0, 0, 0.3);
	}

	/* bottom row: no chrome - brand hue alone keeps each one identifiable */
	.brand-mail :global(svg) { color: #34d399; }
	.brand-instagram :global(svg) { color: #e1306c; }
	.brand-youtube :global(svg) { color: #ff0000; }

	.bare-link:hover span {
		color: rgb(229 229 229);
	}

	.bare-link:hover {
		background: rgba(255, 255, 255, 0.05);
	}
</style>
