---
// Hero component - uses sitewide config
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import { site } from '../config';

const { name, pfp, taglines, links } = site;

// new tab for everything but mail, résumé PDF included
const opensNewTab = (href: string) => !href.startsWith('mailto');

// one 3-wide grid so all six cells share a width; the tier only changes styling
const quickLinks = [
	...links.primary.map((l) => ({ ...l, primary: true })),
	...links.secondary.map((l) => ({ ...l, primary: false })),
];
---

<section class="flex justify-center pt-16 pb-20">
	<div class="flex flex-col items-center gap-4">
		<!-- avatar with glow ring -->
		<div class="fade-up avatar-wrapper mb-1">
			<div class="avatar-glow"></div>
			<Image
				src={pfp}
				alt={name}
				width={120}
				height={120}
				class="avatar relative rounded-full border-2 border-white/20 transition-all duration-500"
			/>
		</div>

		<!-- name with gradient -->
		<h1 class="fade-up delay-1 text-4xl md:text-5xl font-semibold tracking-tight">
			<span class="bg-linear-to-br from-white via-neutral-200 to-neutral-400 bg-clip-text text-transparent">{name}</span>
		</h1>

		<!-- canonical one is server-rendered for no-JS and crawlers; the inline
		     script swaps in a random variant before paint -->
		<p id="tagline" class="fade-up delay-2 text-lg text-neutral-300 tracking-wide max-w-xl text-center leading-relaxed">{taglines[0]}</p>
		<script is:inline define:vars={{ taglines }}>
			(function () {
				// for a daily variant:
				// var i = Math.floor(Date.now() / 86400000) % taglines.length;
				var i = Math.floor(Math.random() * taglines.length);
				if (i > 0) document.getElementById('tagline').textContent = taglines[i];
				// record which one was shown
				window.dataLayer = window.dataLayer || [];
				window.dataLayer.push({ event: 'tagline_variant', tagline_variant: i });
			})();
		</script>

		<!-- quick links: even 3-wide grid, personal row quieter than professional -->
		<nav class="fade-up delay-3 mt-5 w-full max-w-lg" aria-label="Quick links">
			<ul class="grid grid-cols-3 gap-2 sm:gap-3">
				{quickLinks.map(({ href, handle, icon, primary }) => (
					<li>
						<a
							href={href}
							target={opensNewTab(href) ? '_blank' : undefined}
							rel={opensNewTab(href) ? 'noopener noreferrer' : undefined}
							class:list={[
								"quick-link flex w-full items-center justify-center gap-2 rounded-xl border px-2 py-2.5 backdrop-blur-sm transition-all duration-300 sm:px-4",
								primary ? "accent" : "quiet"
							]}
						>
							<Icon name={icon} class="size-4 shrink-0" />
							<span class="truncate text-xs font-medium sm:text-sm">{handle}</span>
						</a>
					</li>
				))}
			</ul>
		</nav>
	</div>
</section>

<style>
	/* avatar with animated glow */
	.avatar-wrapper {
		position: relative;
	}

	.avatar-glow {
		position: absolute;
		inset: -8px;
		border-radius: 50%;
		background: conic-gradient(from 0deg, rgba(16, 185, 129, 0.4), rgba(59, 130, 246, 0.3), rgba(168, 85, 247, 0.3), rgba(16, 185, 129, 0.4));
		filter: blur(20px);
		opacity: 0.6;
		animation: glow-rotate 8s linear infinite;
	}

	@keyframes glow-rotate {
		from { transform: rotate(0deg); }
		to { transform: rotate(360deg); }
	}

	.avatar-wrapper:hover .avatar-glow {
		opacity: 0.9;
		filter: blur(25px);
	}

	.avatar-wrapper:hover .avatar {
		border-color: rgba(255, 255, 255, 0.4);
		transform: scale(1.02);
	}

	/* the rows differ only in brightness */
	.quick-link.accent {
		border-color: rgba(255, 255, 255, 0.2);
		background: rgba(255, 255, 255, 0.1);
		box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
		color: rgb(250 250 250);
	}

	.quick-link.accent:hover {
		transform: translateY(-3px);
		border-color: rgba(255, 255, 255, 0.35);
		background: rgba(255, 255, 255, 0.16);
		box-shadow: 0 8px 20px rgba(0, 0, 0, 0.3);
	}

	/* same cell, dimmer and no lift */
	.quick-link.quiet {
		border-color: rgba(255, 255, 255, 0.08);
		background: rgba(255, 255, 255, 0.03);
		color: rgb(150 150 150);
	}

	.quick-link.quiet:hover {
		background: rgba(255, 255, 255, 0.07);
		border-color: rgba(255, 255, 255, 0.16);
		color: rgb(229 229 229);
	}
</style>
