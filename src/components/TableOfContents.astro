---
interface Heading {
	depth: number;
	slug: string;
	text: string;
}

interface Props {
	headings: Heading[];
}

const { headings } = Astro.props;
const items = headings.filter((h) => h.depth === 2 || h.depth === 3);
const show = items.length >= 2;
---

{show && (
	<>
		<!-- desktop schematic rail -->
		<nav aria-label="Table of contents" class="toc-rail hidden xl:block" data-toc>
			<div class="relative flex flex-col">
				<div class="toc-track absolute top-1 bottom-1 w-px bg-white/10"></div>
				<div class="toc-progress absolute top-1 bottom-1 w-px origin-top scale-y-0 bg-linear-to-b from-emerald-400 to-emerald-400/40"></div>
				{items.map((h) => (
					<a
						href={`#${h.slug}`}
						class="toc-link group relative flex items-center gap-3 py-2.5"
						style={h.depth === 3 ? "padding-left: 0.85rem" : undefined}
						data-slug={h.slug}
					>
						<span class="toc-node relative z-10 block size-[7px] shrink-0 rounded-full border border-white/25 bg-neutral-950 transition-all duration-300"></span>
						<span class="toc-label max-w-32 truncate text-xs text-neutral-500 opacity-0 -translate-x-1 transition-all duration-300">
							{h.text}
						</span>
					</a>
				))}
			</div>
		</nav>

		<!-- mobile / tablet progress button -->
		<div class="toc-mobile fixed bottom-5 right-5 z-30 xl:hidden">
			<div class="toc-popover absolute bottom-full right-0 mb-3 w-56 origin-bottom-right scale-95 rounded-xl border border-white/10 bg-neutral-900/95 p-2 opacity-0 shadow-2xl backdrop-blur-md transition-all duration-200 pointer-events-none">
				{items.map((h) => (
					<a
						href={`#${h.slug}`}
						class="toc-mobile-link block truncate rounded-lg px-3 py-2 text-sm text-neutral-400 transition-colors hover:bg-white/5 hover:text-emerald-300"
						style={h.depth === 3 ? "padding-left: 1.5rem" : undefined}
						data-slug={h.slug}
					>
						{h.text}
					</a>
				))}
			</div>
			<button
				type="button"
				class="toc-mobile-btn relative flex size-12 items-center justify-center rounded-full border border-white/10 bg-neutral-900/90 shadow-lg backdrop-blur-sm"
				aria-label="Table of contents"
				aria-expanded="false"
			>
				<svg class="absolute inset-0 -rotate-90" viewBox="0 0 48 48">
					<circle cx="24" cy="24" r="20" fill="none" stroke="rgba(255,255,255,0.08)" stroke-width="2" />
					<circle class="toc-ring-progress" cx="24" cy="24" r="20" fill="none" stroke="rgb(52,211,153)" stroke-width="2" stroke-linecap="round" />
				</svg>
				<span class="relative text-xs text-neutral-300">§</span>
			</button>
		</div>
	</>
)}

<style>
	.toc-rail {
		position: fixed;
		top: 50%;
		transform: translateY(-50%);
		left: max(1.25rem, calc((100vw - 64rem) / 2 + 1.25rem));
		z-index: 20;
	}

	.toc-link.is-active .toc-node {
		border-color: rgb(52 211 153);
		background-color: rgb(52 211 153);
		box-shadow: 0 0 10px rgba(52, 211, 153, 0.65);
		transform: scale(1.3);
	}

	.toc-link.is-active .toc-label {
		opacity: 1;
		transform: translateX(0);
		color: rgb(167 243 208);
	}

	.toc-link:hover .toc-label {
		opacity: 1;
		transform: translateX(0);
		color: rgb(212 212 212);
	}

	.toc-mobile-link.is-active {
		color: rgb(110 231 183);
		background-color: rgba(255, 255, 255, 0.05);
	}

	.toc-popover.is-open {
		opacity: 1;
		transform: scale(1);
		pointer-events: auto;
	}
</style>

<script>
	function setupToc() {
		const allLinks = Array.from(
			document.querySelectorAll<HTMLAnchorElement>(".toc-link, .toc-mobile-link"),
		);
		if (!allLinks.length) return;

		const setActive = (slug: string) => {
			allLinks.forEach((l) => {
				l.classList.toggle("is-active", l.dataset.slug === slug);
			});
		};

		const headingEls = allLinks
			.map((l) => l.dataset.slug)
			.filter((slug, i, arr): slug is string => !!slug && arr.indexOf(slug) === i)
			.map((slug) => document.getElementById(slug))
			.filter((el): el is HTMLElement => !!el);

		if (headingEls.length) {
			setActive(headingEls[0].id);

			const observer = new IntersectionObserver(
				(entries) => {
					const visible = entries.filter((e) => e.isIntersecting);
					if (!visible.length) return;
					const topmost = visible.reduce((a, b) =>
						a.boundingClientRect.top < b.boundingClientRect.top ? a : b,
					);
					setActive(topmost.target.id);
				},
				{ rootMargin: "-10% 0px -70% 0px", threshold: [0, 1] },
			);
			headingEls.forEach((el) => observer.observe(el));
		}

		const progressEl = document.querySelector<HTMLElement>(".toc-progress");
		const ringEl = document.querySelector<SVGGeometryElement>(".toc-ring-progress");
		const ringCirc = ringEl ? ringEl.getTotalLength() : 0;
		if (ringEl) {
			ringEl.style.strokeDasharray = String(ringCirc);
			ringEl.style.strokeDashoffset = String(ringCirc);
		}

		const updateProgress = () => {
			const scrollable = document.documentElement.scrollHeight - window.innerHeight;
			const progress = scrollable > 0 ? Math.min(1, Math.max(0, window.scrollY / scrollable)) : 0;
			if (progressEl) progressEl.style.transform = `scaleY(${progress})`;
			if (ringEl) ringEl.style.strokeDashoffset = String(ringCirc * (1 - progress));
		};

		let ticking = false;
		window.addEventListener(
			"scroll",
			() => {
				if (ticking) return;
				ticking = true;
				requestAnimationFrame(() => {
					updateProgress();
					ticking = false;
				});
			},
			{ passive: true },
		);
		updateProgress();

		const btn = document.querySelector<HTMLButtonElement>(".toc-mobile-btn");
		const popover = document.querySelector<HTMLElement>(".toc-popover");
		if (btn && popover) {
			const close = () => {
				popover.classList.remove("is-open");
				btn.setAttribute("aria-expanded", "false");
			};
			const open = () => {
				popover.classList.add("is-open");
				btn.setAttribute("aria-expanded", "true");
			};
			btn.addEventListener("click", (e) => {
				e.stopPropagation();
				btn.getAttribute("aria-expanded") === "true" ? close() : open();
			});
			document.addEventListener("click", (e) => {
				if (!popover.contains(e.target as Node) && e.target !== btn) close();
			});
			popover.querySelectorAll("a").forEach((a) => a.addEventListener("click", close));
		}
	}

	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", setupToc);
	} else {
		setupToc();
	}
</script>
