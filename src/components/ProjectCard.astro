---
import TechTag from "./TechTag.astro";
import { Icon } from "astro-icon/components";
import type { CollectionEntry } from "astro:content";
import { slugOf } from "../lib/order";
import { formatRange } from "../lib/date";

interface Props {
    project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const { title, date, tech, summary, inProgress, writeup, links } = project.data;
const slug = slugOf(project);
const range = formatRange(date);
const hasMeta = inProgress || links.site || links.repo;
---

<article class="project-card group relative p-6 rounded-2xl transition-all duration-300 w-full max-w-md sm:max-w-none">
    <!-- glassmorphic background -->
    <div class:list={[
        "absolute inset-0 rounded-2xl backdrop-blur-md",
        inProgress ? "bg-amber-500/[0.02]" : "bg-white/[0.03]"
    ]}></div>
    <div class:list={[
        "absolute inset-0 rounded-2xl border transition-colors duration-300",
        inProgress
            ? "border-amber-500/20 group-hover:border-amber-500/30"
            : "border-white/10 group-hover:border-white/20"
    ]}></div>

    <!-- subtle top highlight -->
    <div class:list={[
        "absolute inset-x-0 top-0 h-px bg-linear-to-r from-transparent to-transparent",
        inProgress ? "via-amber-500/20" : "via-white/10"
    ]}></div>

    <div class="relative flex h-full flex-col gap-4">
        <div class="flex flex-col gap-2">
            <!-- title, date pinned opposite -->
            <div class="flex items-start justify-between gap-3">
                <h3 class="text-xl font-semibold bg-linear-to-br from-white to-neutral-300 bg-clip-text text-transparent">
                    {title}
                </h3>
                {range && (
                    <time class="shrink-0 whitespace-nowrap pt-1.5 font-mono text-xs text-neutral-500">{range}</time>
                )}
            </div>

            <!-- links left, status right; the row holds height so cards stay level -->
            {hasMeta && (
                <div class="flex items-baseline justify-between gap-3">
                    <div class="flex flex-wrap items-center gap-x-4 gap-y-1">
                        {links.repo && (
                            <a
                                href={links.repo}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="inline-flex items-center gap-1.5 text-sm text-neutral-500 transition-colors duration-300 hover:text-neutral-200"
                            >
                                <Icon name="simple-icons:github" class="size-3.5" />
                                <span>Repo</span>
                            </a>
                        )}
                        {links.site && (
                            <a
                                href={links.site}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="inline-flex items-center gap-1.5 text-sm text-neutral-500 transition-colors duration-300 hover:text-neutral-200"
                            >
                                <Icon name="lucide:external-link" class="size-3.5" />
                                <span>Live</span>
                            </a>
                        )}
                    </div>
                    {inProgress && (
                        <span class="flex shrink-0 items-center gap-1.5 whitespace-nowrap text-xs text-amber-400/80">
                            <span class="size-1.5 rounded-full bg-amber-400/60"></span>
                            In Progress
                        </span>
                    )}
                </div>
            )}
        </div>

        <!-- tech stack -->
        <div class="flex flex-wrap gap-2">
            {tech.toSorted((a, b) => a.localeCompare(b)).map((t) => <TechTag tech={t} />)}
        </div>

        <!-- summary -->
        <p class="text-sm text-neutral-400 leading-relaxed">{summary}</p>

        <!-- mt-auto keeps cards in a row aligned -->
        {writeup && (
            <a
                href={`/projects/${slug}`}
                class="project-link mt-auto inline-flex w-fit items-center gap-2 pt-1 text-sm text-neutral-300 transition-all duration-300 hover:text-emerald-400"
            >
                <span>View Project</span>
                <Icon name="lucide:arrow-right" class="arrow size-4 transition-transform duration-300" />
            </a>
        )}
    </div>
</article>

<style>
    .project-card {
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
    }

    .project-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.2);
    }

    .project-link:hover .arrow {
        transform: translateX(4px);
    }
</style>
