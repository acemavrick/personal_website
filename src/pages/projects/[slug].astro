---
import Base from "../../layouts/Base.astro";
import { getCollection, render } from "astro:content";
import TechTag from "../../components/TechTag.astro";
import TableOfContents from "../../components/TableOfContents.astro";
import { Icon } from "astro-icon/components";
import { site } from "../../config";
import { formatRange } from "../../lib/date";

export async function getStaticPaths() {
    // only projects with a writeup get a page
    const projects = await getCollection("projects", ({ data }) => data.writeup);

    return projects.map((proj) => ({
        params: { slug: proj.id.replace(/\.mdx?$/, "") },
        props: { project: proj },
    }));
}

const { project } = Astro.props;
const { data } = project;
const { Content, headings } = await render(project);
const range = formatRange(data.date);
---

<Base 
    title={data.title} 
    description={data.summary}
    keywords={`${data.title}, ${data.tech.join(', ')}, Shubh Randeria`}
    ogType="article"
    bgVariant="article"
>
    <article class="max-w-3xl mx-auto">
        <!-- home link with avatar -->
        <a href="/" class="home-link inline-flex items-center gap-3 text-neutral-400 hover:text-emerald-400 transition-all duration-300 mb-12 group">
            <div class="relative">
                <div class="absolute inset-0 rounded-full bg-emerald-500/20 blur-md opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
                <img src={site.pfp} alt={site.name} class="relative w-9 h-9 rounded-full border border-white/20 group-hover:border-emerald-500/50 transition-all duration-300" />
            </div>
            <span class="text-sm font-medium">Home</span>
        </a>

        <header class="mb-14 flex flex-col gap-5">
            <h1 class="text-3xl md:text-5xl font-bold bg-linear-to-br from-white to-neutral-300 bg-clip-text text-transparent">{data.title}</h1>
            {data.inProgress && (
                <span class="flex items-center gap-1.5 text-xs text-amber-400/80 w-fit px-2 py-1 rounded-full bg-amber-500/10 border border-amber-500/20">
                    <span class="size-1.5 rounded-full bg-amber-400/60"></span>
                    In Progress
                </span>
            )}
            <div class="flex flex-wrap gap-2">
                {data.tech.toSorted((a, b) => a.localeCompare(b)).map((tech) => <TechTag {tech} />)}
            </div>
            <p class="text-lg text-neutral-200 leading-relaxed">{data.summary}</p>
            {(range || data.links.site || data.links.repo) && (
                <div class="flex flex-wrap items-center gap-x-5 gap-y-2 text-sm">
                    {range && <time class="font-mono text-xs text-neutral-500">{range}</time>}
                    {data.links.site && (
                        <a href={data.links.site} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-neutral-400 transition-colors hover:text-emerald-400">
                            <Icon name="lucide:external-link" class="size-3.5" />
                            <span>Site</span>
                        </a>
                    )}
                    {data.links.repo && (
                        <a href={data.links.repo} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-neutral-400 transition-colors hover:text-emerald-400">
                            <Icon name="simple-icons:github" class="size-3.5" />
                            <span>Repo</span>
                        </a>
                    )}
                </div>
            )}
            <div class="w-20 h-px bg-linear-to-r from-emerald-500/60 via-blue-500/30 to-pink-500/20 mt-2"></div>
        </header>

        <section class="prose prose-lg prose-invert max-w-none">
            <Content />
        </section>
    </article>

    <TableOfContents headings={headings} title={data.title} href={`/projects/${Astro.params.slug}`} />
</Base>
