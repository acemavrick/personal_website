---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import { site } from '../config';
import { getCollection } from 'astro:content';
import ProjectCard from '../components/ProjectCard.astro';

const projects = (await getCollection("projects")).sort((a, b) => {
	// in-progress projects first
	if (a.data.inProgress !== b.data.inProgress) {
		return a.data.inProgress ? -1 : 1;
	}
	// then alphabetical by id
	return a.id.localeCompare(b.id);
});
---

<Base title={site.name}>
	<Hero />

	<!-- site update notice -->
	<div class="fade-up delay-5 mb-10 flex items-start gap-3 rounded-xl border border-amber-500/20 bg-amber-500/5 px-4 py-3.5 backdrop-blur-sm">
		<span class="mt-0.5 shrink-0 text-amber-400">
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4">
				<path d="M12 20h9"/>
				<path d="M16.376 3.622a1 1 0 0 1 3.002 3.002L7.368 18.635a2 2 0 0 1-.855.506l-2.872.838a.5.5 0 0 1-.62-.62l.838-2.872a2 2 0 0 1 .506-.854z"/>
			</svg>
		</span>
		<div class="min-w-0">
			<p class="text-sm text-amber-200/90">
				<span class="font-medium">Site update in progress</span>
				<span class="mx-1.5 text-amber-500/60">·</span>
				<span class="text-amber-400/70 text-xs">Sep 22, 2026</span>
			</p>
			<p class="mt-0.5 text-xs text-neutral-400">
				This site is being updated with new information. Check back soon!
			</p>
		</div>
	</div>

	<!-- for now, just display a wall of project cards -->

    <header class="mb-12">
        <h1 class="text-3xl md:text-4xl font-bold bg-linear-to-br from-white to-neutral-300 bg-clip-text text-transparent">
            Projects
        </h1>
        <p class="text-neutral-400 mt-3">Some of the things that I've built so far.
			I am in the process of writing more about each project and updating this collection.
			To see all of my projects, visit my GitHub profile (linked above),
			which will always be up to date.
		</p>
    </header>

    <!-- project gallery grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {projects.map((project) => (
            <ProjectCard project={project} />
        ))}
    </div>
</Base>