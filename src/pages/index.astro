---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import { site } from '../config';
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';
import ProjectCard from '../components/ProjectCard.astro';
import { orderProjects } from '../lib/order';

const projects = orderProjects(await getCollection('projects'));
const github = site.links.primary.find((l) => l.icon === 'simple-icons:github')!.href;
---

<Base title={site.name}>
	<Hero />

    <header class="mb-10">
        <h1 class="text-3xl md:text-4xl font-bold bg-linear-to-br from-white to-neutral-300 bg-clip-text text-transparent">
            Projects
        </h1>
        <p class="text-neutral-400 mt-3">
			A selection of some things I've made, which is modified constantly and excludes some of my work. For a more comprehensive list, check out my {' '}
			<a href={github} target="_blank" rel="noopener noreferrer" class="text-neutral-300 underline decoration-neutral-600 underline-offset-4 transition-colors hover:text-emerald-400 hover:decoration-emerald-400/50">GitHub</a>.
		</p>
    </header>

    <!-- project gallery grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 items-stretch">
        {projects.map((project) => (
            <ProjectCard project={project} />
        ))}

        <!-- terminates the grid -->
        <a
            href={github}
            target="_blank"
            rel="noopener noreferrer"
            class="more-card group relative col-span-full flex w-full items-center justify-center gap-3 rounded-2xl border-2 border-dashed border-white/15 bg-white/[0.03] p-6 text-neutral-400 transition-all duration-300"
        >
            <Icon name="simple-icons:github" class="size-5" />
            <span class="text-sm font-medium">See everything on GitHub</span>
            <Icon name="lucide:arrow-right" class="arrow size-4 transition-transform duration-300" />
        </a>
    </div>
</Base>

<style>
    .more-card:hover {
        border-color: rgba(255, 255, 255, 0.3);
        background: rgba(255, 255, 255, 0.06);
        color: rgb(229 229 229);
    }

    .more-card:hover .arrow {
        transform: translateX(4px);
    }
</style>
